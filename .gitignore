# ==========================================
.cache/
.vite/
.eslintcache
.stylelintcache
tmp/
temp/
*.tmp

# ==========================================
# Logs & Process Outputs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
