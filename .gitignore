# ==========================================
dist/
dist-ssr/
build/
out/
release/
studio/release/
studio/bin/
bin/
*.tsbuildinfo

# ==========================================
# Remotion & Media Render Artifacts
# ==========================================
.remotion/
*.mp4
*.mkv
*.avi
*.mov
*.webm
renders/
render/

# ==========================================
