.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# Machine-specific encrypted authentication tokens & agent keys
studio/server/user-auth.json
user-auth.json
**/user-auth.json
studio/server/agent-config.json
agent-config.json
**/agent-config.json
scratch_*.json

